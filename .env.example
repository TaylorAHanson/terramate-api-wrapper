# Local development only. Never commit a real .env — in a deployed Databricks
# App these values come from the app resources / secret scope wired in
# databricks.yml (see docs/adr and architecture.md §10), not from disk.

APP_ENVIRONMENT=local

# Local/dev/test override: a full connection string to a plain Postgres
# instance. When set, the app skips the Lakebase OAuth token flow entirely.
# In CI this points at the postgres service container (see .github/workflows/ci.yml).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/terramate_dev

# Production (Databricks App) path: PGHOST/PGPORT/PGDATABASE/PGUSER are injected
# by the app's `postgres` resource attachment; LAKEBASE_INSTANCE_NAME is set
# explicitly in databricks.yml so the app can mint an OAuth credential for the
# right instance via the Databricks SDK. Leave DATABASE_URL unset for this path.
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# LAKEBASE_INSTANCE_NAME=

# GitHub service-account PAT, sourced from a Databricks secret scope in
# deployment (never on disk in a real environment).
GITHUB_PAT=
